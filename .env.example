# ---------------------------------------------------------------------------
# Stockly (ستوكلي) - example environment template
# ---------------------------------------------------------------------------
# THIS FILE CONTAINS NO SECRETS AND IS SAFE TO COMMIT.
# Copy it to `.env` (git-ignored) and fill in real values locally.
# In production, values come from a secret store / orchestrator secrets and this
# file is not used at all.
#
# NEVER put a real password, PIN, JWT key, encryption key, connection string
# with a password, or certificate in this file.
# See docs/SECURITY_ARCHITECTURE.md section 7 (Cryptography and secrets).
# ---------------------------------------------------------------------------

# --- General ---------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
TZ=UTC

# --- Database (no password here; use a user-secrets / docker-secret reference) --
ConnectionStrings__StocklyDb=Server=localhost,1433;Database=Stockly;User Id=stockly_app;Encrypt=true;TrustServerCertificate=false;MultipleActiveResultSets=false

# Migrations are NEVER applied automatically in production.
Database__AutoMigrateOnStartup=false
Database__CommandTimeoutSeconds=30
Database__ReportingCommandTimeoutSeconds=120

# --- Authentication --------------------------------------------------------
# Access token lifetime (minutes)
Auth__AccessTokenMinutes=15
# Session idle timeout for password sessions (minutes)
Auth__PasswordSessionIdleMinutes=60
# Session idle timeout for shared terminals (minutes)
Auth__TerminalSessionIdleMinutes=15
# Session idle timeout for platform operator sessions (minutes)
Auth__PlatformSessionIdleMinutes=30
# Absolute session lifetime (hours)
Auth__SessionAbsoluteHours=12
# Maximum concurrent sessions per device (1 = kiosk default; TBD-11)
Auth__MaxSessionsPerDevice=1
# Minimum PIN length (>= 6)
Auth__MinimumPinLength=6
# Argon2id parameters. DECIDED in PROJECT_BLUEPRINT.md 23 TBD-02 / ADR-0008,
# not TBD: m=64 MiB, t=3, p=2. PBKDF2-HMAC-SHA256 is the documented fallback
# for constrained hardware only.
Auth__PasswordHashAlgorithm=Argon2id
Auth__Argon2MemoryKiB=65536
Auth__Argon2Iterations=3
Auth__Argon2Parallelism=2

# --- Secrets that MUST be supplied from a secret store (NEVER a literal here) -
# HMAC pepper for throttle identifiers: HMAC-SHA256(identifier, pepper).
# NO DEFAULT EXISTS ON PURPOSE. The application refuses to start when it is
# missing, because a checked-in default would be a shared secret in every
# deployment (ADR-0036, SECURITY_ARCHITECTURE.md 7).
# Inject with a real value, e.g. from a mounted file:
#   Auth__IdentifierPepper=/run/secrets/stockly_identifier_pepper
# or, in development only, generate one per machine and keep it in .env:
#   Auth__IdentifierPepper=$(openssl rand -base64 32)
Auth__IdentifierPepper=

# Token signing key (RSA private key, PEM path or base64 body) and the previous
# key for zero-downtime rotation overlap. Also secret-store supplied.
Auth__SigningKeyPemPath=
Auth__PreviousSigningKeyPemPath=

# --- Rate limiting (TBD-04: numbers are provisional, all config-driven) -----
RateLimit__GlobalPerMinute=300
RateLimit__AuthPerMinutePerIp=10
RateLimit__AuthFailuresPerIdentity=5
RateLimit__PinFailuresPerDevice=5
RateLimit__PinFailuresPerMembership=5
# Per enrollment code: protects the code itself, not only the resolved device
RateLimit__PinFailuresPerEnrollmentCode=5
# The identities endpoint discloses a staffing list (SEC-KNW-08)
RateLimit__TerminalIdentitiesPerMinute=30
RateLimit__ReportsPerMinute=30
RateLimit__ExportsPerHourPerTenant=10

# --- Uploads / limits -------------------------------------------------------
Limits__MaxRequestBodyBytes=1048576
Limits__MaxUploadBytes=26214400
Limits__MaxPageSize=200
Limits__MaxBulkItems=500

# --- File storage ----------------------------------------------------------
FileStore__Provider=Local
FileStore__LocalPath=/var/stockly/files
FileStore__MaxFileBytes=26214400

# --- Security headers / origins -------------------------------------------
Cors__AllowedOrigins=http://localhost:5173
Security__HstsEnabled=false
Security__EnableSwaggerUi=true

# --- Outbox / background worker -------------------------------------------
Outbox__BatchSize=50
Outbox__PollIntervalSeconds=5
Outbox__MaxAttempts=8

# --- Logging ---------------------------------------------------------------
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
Logging__LogLevel__Stockly=Information
